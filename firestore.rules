rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // El puntaje lo calcula el cliente en el browser, así que cualquiera
    // podía pisar game.totalScore desde la consola con el número que
    // quisiera. Pasó de verdad: una cuenta llegó a 2.237.337 puntos,
    // imposible jugando (a 100 pts por acierto son +22.000 aciertos).
    // Ahora el dueño del documento NO puede escribir game.totalScore ni
    // game.scoreSyncedAt ni game.scoreBudget: los sube el servidor (app/api/sync-score) con un
    // tope por tiempo transcurrido. Solo el admin puede corregirlo a mano
    // desde el panel. totalLives/streak son valores chicos por diseño
    // (lib/userDataManager.ts).
    function isValidGame(game) {
      return game.totalScore is int &&
        game.totalScore >= 0 &&
        game.totalLives is int &&
        game.totalLives >= 0 &&
        game.totalLives <= 3 &&
        game.streak is int &&
        game.streak >= 0 &&
        game.streak <= 100000;
    }

    // El autor de un contenido (trivia, lección, completa palabras) solo lo
    // puede cambiar el admin. Antes el dueño podía actualizar su propio
    // documento con author == "CRESI" y hacerlo pasar por contenido OFICIAL:
    // las pantallas de los alumnos listan `where author == 'CRESI'`, así que
    // aparecía en el catálogo de todos.
    // Los alumnos que entran con código de clase (/api/join-class) llevan la
    // marca `student` en su token de Firebase: la firma Firebase, el usuario
    // no puede quitársela. No pueden crear clases, trivias, lecciones ni salas
    // (antes cualquier usuario logueado podía, aunque un alumno nunca usa esas
    // funciones): son menores y eso cierra una vía de abuso desde la consola.
    // Leer, entregar sus tareas y jugar siguen igual. Solo aplica a quien ya
    // está logueado (`request.auth != null`).
    function isStudent() {
      return request.auth.token.get('student', false) == true;
    }

    function authorUnchanged() {
      return request.resource.data.get('author', null) == resource.data.get('author', null);
    }

    match /classrooms/{classroomId} {
      allow create: if request.auth != null && !isStudent() && request.auth.uid == request.resource.data.profesorId;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.profesorId;

      match /estudiantes/{estudianteId} {
        allow read: if request.auth != null && (
          request.auth.uid == estudianteId ||
          request.auth.uid == get(/databases/$(database)/documents/classrooms/$(classroomId)).data.profesorId
        );
        // El resumen de progreso que el alumno copia acá no puede declarar
        // más puntaje que el validado por el servidor en users/{uid}
        // (game.totalScore, ver /api/sync-score); si no, el ranking por
        // clase sería falsificable desde la consola.
        allow create, update: if request.auth != null && (
          (request.auth.uid == estudianteId && (
            !('progress' in request.resource.data) ||
            !('totalScore' in request.resource.data.progress) ||
            request.resource.data.progress.totalScore <=
              get(/databases/$(database)/documents/users/$(estudianteId)).data.game.get('totalScore', 0)
          )) ||
          request.auth.uid == get(/databases/$(database)/documents/classrooms/$(classroomId)).data.profesorId
        );
        allow delete: if request.auth != null && (
          request.auth.uid == estudianteId ||
          request.auth.uid == get(/databases/$(database)/documents/classrooms/$(classroomId)).data.profesorId
        );
      }
      match /estudiantesPendientes/{pendingId} {
        allow read: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/classrooms/$(classroomId)).data.profesorId;
        // Las altas y el cambio de usuario/contraseña los hace el servidor
        // (/api/pending-students, con el Admin SDK): la contraseña se guarda
        // cifrada y el cliente no debe poder escribirla en texto plano.
        allow create: if false;
        allow delete: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/classrooms/$(classroomId)).data.profesorId;
        // Desde el cliente solo se toca el estado de "reclamado" (reiniciar
        // el acceso de un alumno). Antes esta regla dejaba reescribir
        // cualquier campo, contraseña incluida.
        allow update: if request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedUid']) && (
            request.auth.uid == get(/databases/$(database)/documents/classrooms/$(classroomId)).data.profesorId ||
            (resource.data.claimedUid == null && request.resource.data.claimedUid == request.auth.uid)
          );
      }

      // Tareas: el docente crea/edita/borra; cualquiera de la clase
      // (docente o alumno) puede leerlas, para que el alumno vea lo
      // asignado.
      match /tareas/{tareaId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/classrooms/$(classroomId)).data.profesorId;

        // Entregas: cada alumno lee/escribe la propia (entrega, edita su
        // respuesta); el docente lee todas y las califica (la calificación
        // en sí es un update, así que el docente necesita permiso de
        // update acá también, no solo el alumno).
        match /entregas/{studentUid} {
          function isClassTeacher() {
            return request.auth != null &&
              request.auth.uid == get(/databases/$(database)/documents/classrooms/$(classroomId)).data.profesorId;
          }

          allow read: if request.auth != null && (
            request.auth.uid == studentUid || isClassTeacher()
          );
          // El alumno escribe SU entrega, pero no puede ponerse nota ni
          // escribir la devolución del docente, ni apuntarla a otra clase
          // (`classroomId` / `claseId` denormalizados: con eso el docente de
          // OTRA clase la vería en su cuaderno). El docente sí puede escribir
          // todo: es quien califica.
          //
          // Hay DOS vocabularios para lo mismo, porque escriben dos apps:
          //   cresi-play (types/tarea.ts): grade, feedback, gradedAt, classroomId
          //   classroom  (lib/taskService.ts): calificacion, comentarios, claseId
          function studentCantGrade(keys) {
            return !keys.hasAny(['grade', 'feedback', 'gradedAt', 'calificacion', 'comentarios']);
          }
          function studentStaysInClass() {
            return request.resource.data.get('classroomId', classroomId) == classroomId &&
              request.resource.data.get('claseId', classroomId) == classroomId;
          }
          allow create: if request.auth != null && (
            isClassTeacher() ||
            (request.auth.uid == studentUid &&
              studentCantGrade(request.resource.data.keys()) &&
              studentStaysInClass())
          );
          allow update: if request.auth != null && (
            isClassTeacher() ||
            (request.auth.uid == studentUid &&
              studentCantGrade(request.resource.data.diff(resource.data).affectedKeys()) &&
              studentStaysInClass())
          );
        }
      }
    }

    // Cuaderno de calificaciones (TareasGradebook.tsx): una consulta
    // `collectionGroup('entregas')` filtrada por `classroomId` trae TODAS
    // las entregas de una clase en una sola lectura, en vez de una
    // consulta por cada tarea. La regla anidada de arriba
    // (classrooms/{id}/tareas/{id}/entregas/{uid}) ya autoriza cada
    // entrega por su ruta específica, pero una consulta `collectionGroup`
    // necesita ADEMÁS su propia regla con el comodín recursivo
    // `{path=**}` — Firestore no la deriva de la regla anidada.
    // `resource.data.classroomId` es el campo que denormaliza
    // TareaService.submitEntrega — las entregas creadas antes de agregar
    // ese campo no lo tienen, así que el `where` de la consulta ya las
    // descarta antes de llegar a evaluar esta regla (no hay que
    // contemplarlas acá).
    match /{path=**}/entregas/{entregaId} {
      allow read: if request.auth != null && (
        request.auth.uid == entregaId ||
        request.auth.uid == get(/databases/$(database)/documents/classrooms/$(resource.data.classroomId)).data.profesorId
      );
    }

    // Contadores de intentos fallidos de /api/join-class (lib/rateLimitStore.ts):
    // los escribe y lee solo el servidor con el Admin SDK, que ignora las
    // reglas. Ningún cliente puede tocarlos — si pudiera, un alumno podría
    // borrar su contador (o inflar el de otro para bloquearlo).
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /preguntas/{preguntaId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1"
      );
    }
    match /blog_posts/{blogPostId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1"
      );
    }
    // Infografías — contenido de diseño, lo sube solo CrESI (no hay
    // pantalla para que el docente cree las propias, a diferencia de
    // trivias/completapalabras). Mismo criterio que questions/blog_posts.
    match /infografias/{infografiaId} {
      allow read: if true;
      allow create, delete: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1"
      );
      // El contador de descargas (InfografiaService.incrementDownloads) se
      // suma tanto desde el catálogo público como desde una tarea — mismo
      // criterio que `downloads` en resources y playCount en trivia: se
      // permite sin login porque no es un dato sensible, y solo puede
      // subir de a 1.
      allow update: if (
        request.auth != null && (
          request.auth.token.admin == true ||
          request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1"
        )
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']) &&
        request.resource.data.downloads == resource.data.get('downloads', 0) + 1
      );
    }
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.admin == true ||
        request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1"
      );
      allow create: if request.auth != null && request.auth.uid == userId &&
        (!('game' in request.resource.data) || (
          isValidGame(request.resource.data.game) &&
          request.resource.data.game.totalScore == 0 &&
          !('scoreSyncedAt' in request.resource.data.game) &&
          !('scoreBudget' in request.resource.data.game)
        ));
      allow update: if request.auth != null && (
        (request.auth.uid == userId &&
          (!('game' in request.resource.data) || (
            isValidGame(request.resource.data.game) &&
            request.resource.data.game.totalScore == resource.data.get('game', {}).get('totalScore', 0) &&
            request.resource.data.game.get('scoreSyncedAt', null) == resource.data.get('game', {}).get('scoreSyncedAt', null) &&
            request.resource.data.game.get('scoreBudget', null) == resource.data.get('game', {}).get('scoreBudget', null)
          ))
        ) ||
        // El panel admin puede corregir el puntaje de una cuenta (ver
        // caso real en el comentario de isValidGame más arriba), pero
        // solo ese campo — no el resto del documento del usuario.
        (
          (request.auth.token.admin == true || request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1") &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['game']) &&
          isValidGame(request.resource.data.game)
        )
      );
      allow delete: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1"
      );
    }
    match /resources/{resourceId} {
      allow read: if true;
      allow create, delete: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1"
      );
      // El contador de descargas (ResourceService.incrementDownloads) se
      // suma tanto desde la plataforma principal como desde acá (tareas
      // con un recurso adjunto) — mismo criterio que playCount/
      // questionStats en trivia más arriba: se permite sin login porque
      // no es un dato sensible ni explotable, y solo puede subir de a 1.
      allow update: if (
        request.auth != null && (
          request.auth.token.admin == true ||
          request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1"
        )
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']) &&
        request.resource.data.downloads == resource.data.get('downloads', 0) + 1
      );
    }
    match /completapalabras/{lessonId} {
      allow read: if true;
      allow create: if request.auth != null && !isStudent() &&
        request.resource.data.author == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.author == request.auth.uid && authorUnchanged();
      allow delete: if request.auth != null &&
        resource.data.author == request.auth.uid;
    }
    // Lecciones (contenido de lectura + preguntas V/F) — antes vivían
    // hardcodeadas en el código. Mismo criterio que completapalabras: el
    // contenido de CrESI se lee público, y queda preparado para que un
    // docente cree las propias más adelante (author = su uid).
    // El contenido oficial usa author == "CRESI" literal (no un uid), para
    // que la app de alumnos lo distinga del de los docentes con un simple
    // where('author', '==', 'CRESI'). Por eso el admin necesita un bypass
    // explícito solo para ese caso — su uid nunca va a ser igual al string
    // "CRESI" bajo la regla genérica de arriba.
    match /lecciones/{leccionId} {
      allow read: if true;
      allow create: if request.auth != null && !isStudent() && (
        request.resource.data.author == request.auth.uid ||
        (request.resource.data.author == "CRESI" && (
          request.auth.token.admin == true || request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1"
        ))
      );
      allow update: if (
        (request.auth != null && (
          (resource.data.author == request.auth.uid && authorUnchanged()) ||
          (resource.data.author == "CRESI" && (
            request.auth.token.admin == true || request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1"
          ))
        )) ||
        // Contador de "veces completada" (timesCompleted), mismo criterio
        // que playCount en trivia: lo suma cualquiera que termine la
        // lección, logueado o anónimo — no es un dato sensible.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timesCompleted'])
      );
      allow delete: if request.auth != null && (
        resource.data.author == request.auth.uid ||
        (resource.data.author == "CRESI" && (
          request.auth.token.admin == true || request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1"
        ))
      );
    }
    // Igual que lecciones: el catálogo oficial de trivias usa
    // author == "CRESI" literal (lo filtra así la app de alumnos en
    // app/(routes)/trivias/page.tsx), así que el admin necesita este
    // bypass puntual — nunca va a cumplir author == request.auth.uid
    // contra un valor que es un string fijo, no un uid.
    match /trivia/{triviaId} {
      allow read: if true;
      allow create: if request.auth != null && !isStudent() && (
        request.resource.data.author == request.auth.uid ||
        (request.resource.data.author == "CRESI" && (
          request.auth.token.admin == true || request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1"
        ))
      );
      allow update: if (
        (request.auth != null && (
          ((resource.data.author == request.auth.uid ||
            resource.data.userId == request.auth.uid ||
            resource.data.user_id == request.auth.uid) && authorUnchanged()) ||
          (resource.data.author == "CRESI" && (
            request.auth.token.admin == true || request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1"
          ))
        )) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playCount']) ||
        // Estadística de "en qué se equivocan más" (questionStats): la
        // escribe cualquiera que esté jugando, logueado o anónimo, igual
        // que playCount arriba — no es un dato sensible ni explotable.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['questionStats'])
      );
      allow delete: if request.auth != null && (
        resource.data.author == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.user_id == request.auth.uid ||
        (resource.data.author == "CRESI" && (
          request.auth.token.admin == true || request.auth.uid == "feHhnkE3m1Yzbwn4AgEA7rJjsul1"
        ))
      );
    }

    // Nube de Palabras (estilo Mentimeter): el/la docente crea la sala
    // logueado/a, pero los alumnos que mandan palabras NO tienen cuenta —
    // entran solo con el código, desde el celular. Por eso `words` no
    // valida quién escribe (no hay identidad que chequear) sino la FORMA
    // del dato: texto corto y contador positivo. No hay incentivo real
    // para falsear esto, mismo criterio que playCount/questionStats en
    // trivia de arriba.
    match /wordclouds/{code} {
      allow read: if true;
      allow create: if request.auth != null && !isStudent() && request.auth.uid == request.resource.data.teacherId;
      allow update: if request.auth != null && request.auth.uid == resource.data.teacherId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.teacherId;

      match /words/{wordId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['text', 'count', 'updatedAt']) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 30 &&
          request.resource.data.count is int &&
          request.resource.data.count > 0 &&
          request.resource.data.count <= 100000;
        // Solo el/la docente dueño/a de la sala puede borrar una palabra
        // (por ejemplo, si alguien manda algo inapropiado).
        allow delete: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/wordclouds/$(code)).data.teacherId;
      }
    }

    // Trivia en vivo (estilo Kahoot): mismo criterio "sala con código, sin
    // login" que Nube de Palabras arriba — jugadores y respuestas se
    // validan por FORMA del dato, no por identidad. El puntaje lo calcula
    // el propio cliente que responde (si acertó + qué tan rápido); no hay
    // nada que ganar falseándolo en una trivia de clase, mismo argumento
    // que playCount/questionStats/wordclouds.
    match /livetrivias/{code} {
      allow read: if true;
      allow create: if request.auth != null && !isStudent() && request.auth.uid == request.resource.data.teacherId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.teacherId;

      match /players/{playerId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'joinedAt']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 30 &&
          request.resource.data.score == 0;
        // Nombre/fecha de ingreso quedan fijos una vez creado — lo único
        // que se puede tocar después es el puntaje, que el propio alumno
        // suma con `increment()` al responder cada pregunta.
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score']) &&
          request.resource.data.score is int;
        // Solo el/la docente dueño/a de la sala puede sacar a un jugador.
        allow delete: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/livetrivias/$(code)).data.teacherId;
      }

      match /answers/{answerId} {
        allow read: if true;
        // Solo `create`, nunca `update`: el id del documento es
        // "{playerId}_{questionIndex}", así que un segundo intento sobre
        // la misma pregunta pisa un doc que YA existe — eso cae bajo
        // `update`, que no está permitido, así que la respuesta queda
        // fija en cuanto se manda una vez.
        allow create: if request.resource.data.keys().hasOnly(['playerId', 'questionIndex', 'optionIndex', 'correct', 'pointsEarned', 'answeredAt']) &&
          request.resource.data.playerId is string &&
          request.resource.data.questionIndex is int &&
          request.resource.data.optionIndex is int &&
          request.resource.data.correct is bool &&
          request.resource.data.pointsEarned is int &&
          request.resource.data.pointsEarned >= 0 &&
          request.resource.data.pointsEarned <= 1000;
        // Sin esto, LiveTriviaService.deleteSession() no puede borrar las
        // respuestas de una partida jugada (siempre tiene al menos una) y
        // "Borrar partida" falla en silencio para toda partida ya usada.
        allow delete: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/livetrivias/$(code)).data.teacherId;
      }
    }
  }
}
