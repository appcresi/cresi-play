# Clave para cifrar las contraseñas de los alumnos que arma el docente
# (estudiantesPendientes). 32 bytes en base64: openssl rand -base64 32
# Tiene que ser la MISMA en todas las instancias y NO se puede perder: sin
# ella las contraseñas ya cifradas no se pueden leer (habría que reasignarlas).
PENDING_PASSWORD_KEY=

# Firma la cookie de sesión del servidor (lib/sessionToken.ts). Al menos 32
# bytes: openssl rand -base64 48. Cambiarla cierra todas las sesiones del
# servidor (los usuarios la recuperan solos en su próxima visita).
SESSION_SECRET=
