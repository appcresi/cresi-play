# Copiá este archivo a `.env.local` y completalo. Ver README.md → "Variables de entorno".
# En Vercel se cargan en Settings → Environment Variables (y hay que volver a
# desplegar para que tomen efecto).

# ── Firebase (cliente) ─────────────────────────────────────────────────────
# Públicas: van al navegador. Salen de la consola de Firebase → Configuración del proyecto.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (servidor) ──────────────────────────────────────────────
# Cuenta de servicio (consola de Firebase → Cuentas de servicio → Generar clave).
# La usan las rutas de /api (session, sync-score, join-class, pending-students,
# delete-account, certificado). Requiere Node 22.x.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Pegala en UNA línea, con los saltos de línea escritos como \n literales:
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Secretos propios ───────────────────────────────────────────────────────
# Generalos con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

# Firma la cookie de sesión del servidor (lib/sessionToken.ts). Al menos 32
# bytes. Cambiarla cierra todas las sesiones del servidor (los usuarios la
# recuperan solos en su próxima visita).
SESSION_SECRET=

# Cifra las contraseñas de los alumnos que arma el docente (estudiantesPendientes).
# EXACTAMENTE 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Tiene que ser la MISMA en todas las instancias y NO se puede perder: sin ella
# las contraseñas ya cifradas no se pueden leer (habría que reasignarlas).
PENDING_PASSWORD_KEY=

# Firma los certificados de trivia (utils/jwt.ts, /api/certificado).
JWT_SECRET=

# (Opcional) Habilita /api/health?deep=1, que además lee Firestore. Si lo
# usás, cargá el MISMO valor como secreto HEALTH_TOKEN en GitHub Actions.
HEALTH_TOKEN=

# ── Seguridad (opcionales) ─────────────────────────────────────────────────
# Pasa la política de contenido (CSP) de "solo observar" a "bloquear". Ver
# README → "Encabezados de seguridad": primero mirar el log `CSP (observación)`.
# CSP_ENFORCE=1

# Cada cuántos ms se vuelve a preguntar a Firebase Auth si una sesión fue
# revocada (por usuario, por instancia). Por defecto 60000.
# SESSION_REVOCATION_TTL_MS=60000

# ── Analytics / anuncios (opcionales) ──────────────────────────────────────
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_GA_ADSENSE_KEY=
